APP_NAME="BLR15 API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8199

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blr15_backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# BLR15 API specific
# ---------------------------------------------------------------------------

# JWT (php-open-source-saver/jwt-auth) — generate the secret with: php artisan jwt:secret
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=120
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

# CORS — comma separated origins allowed to call the API (SPA + mobile app)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# SMTP — leave SMTP_PASS blank to run emails in simulated (no delivery) mode.
# These can also be configured at runtime from the Admin → SMTP panel.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BLR15 Home Loans" <contact@blr15homeloans.com>
SMTP_ADMIN_EMAIL=godwinrobby1985@gmail.com
