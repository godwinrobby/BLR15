APP_NAME="BLR15 API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8199

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# NOTE: this box's MySQL listens on 3307 (nothing on 3306) — `ss -ltn | grep 3306`.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=blr15_backend
DB_USERNAME=root
DB_PASSWORD=

# Password applied to every account created by AdminUserSeeder
# (`php artisan migrate --seed`) and by `php artisan admin:login` when no
# --password is passed. Defaults to "password123" — set a strong value here in
# production rather than relying on the default.
SEED_PASSWORD="password123"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# BLR15 API specific
# ---------------------------------------------------------------------------

# JWT (php-open-source-saver/jwt-auth) — generate the secret with: php artisan jwt:secret
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=120
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

# CORS — comma separated origins allowed to call the API (SPA + mobile app)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="contact@blr15homeloans.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMTP — leave SMTP_PASS blank to run emails in simulated (no delivery) mode.
# These can also be configured at runtime from the Admin → SMTP panel.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="\"BLR15 Home Loans\" <contact@blr15homeloans.com>"
SMTP_ADMIN_EMAIL=godwinrobby1985@gmail.com
